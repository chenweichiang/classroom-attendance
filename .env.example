# 複製成 .env（chmod 600），與 docker-compose.yml 放同一層。Copy to .env (chmod 600) next to docker-compose.yml.

# 必填：簽章與裝置雜湊的金鑰。學期中不要換，一換全班的手機綁定同時失效。
# Required. Signing key for QR tokens and device hashes. Do NOT rotate mid-semester: every device binding breaks.
#   python3 -c "import secrets;print(secrets.token_hex(32))"
ATTEND_SECRET=

# 必填：老師端登入密碼。Required. Teacher login password.
ATTEND_TEACHER_PASSWORD=

# 必填：學生掃 QR 會連到的公開網址（https）。QR 內容、cookie 名稱與頁面上的網址都由它決定。
# Required. Public https URL students reach by scanning the QR. Drives QR contents, cookie naming and on-page URLs.
ATTEND_BASE_URL=https://attend.example.edu

# 選填：結束點名時把缺席／遲到名單發到 Discord 頻道才需要（bot token）。
# Optional. Discord bot token, only if you want absence lists posted to a channel when a session closes.
DISCORD_TOKEN=
